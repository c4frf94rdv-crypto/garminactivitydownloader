#!/bin/sh
# Automatically create a git tag when _version.py is committed with a new version.

VERSION_FILE="_version.py"

# Only act if _version.py was part of this commit
if ! git diff-tree --no-commit-id -r HEAD --name-only | grep -qx "$VERSION_FILE"; then
    exit 0
fi

VERSION=$(python -c "import re, sys; m = re.search(r'__version__\s*=\s*[\"\'](.*?)[\"\']', open('$VERSION_FILE').read()); sys.stdout.write(m.group(1)) if m else sys.exit(1)" 2>/dev/null)
if [ -z "$VERSION" ]; then
    echo "post-commit: could not read version from $VERSION_FILE — skipping tag"
    exit 0
fi

TAG="v$VERSION"

# Skip only if the tag already exists on the remote. Checking the remote (not just
# the local tag list) lets us recover from an earlier push that failed while offline:
# the local tag may exist while origin never received it.
if git ls-remote --tags origin "refs/tags/$TAG" | grep -q "refs/tags/$TAG"; then
    echo "post-commit: tag $TAG already exists on origin — skipping"
    exit 0
fi

# Create the local tag only if it is missing (e.g. left over from a previously failed push)
if ! git tag | grep -qx "$TAG"; then
    git tag "$TAG"
    echo "post-commit: created tag $TAG"
fi

git push origin "$TAG"
echo "post-commit: pushed tag $TAG to origin"
