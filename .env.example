# ============================================================
# Garmin Activity Downloader — Configuration
# Copy this file to ".env" and adjust the values as needed.
# ============================================================


# ------------------------------------------------------------
# Garmin Connect Credentials
# Only required if no saved tokens are present.
# Leave empty to log in interactively on first start
# (requires access to the browser terminal on port 9000).
# ------------------------------------------------------------
USER_EMAIL=
USER_PASSWORD=


# ------------------------------------------------------------
# Directories & Database
# ------------------------------------------------------------

# Base directory where all data (downloads, database, logs) is stored.
# Default: <working directory>/data  (in Docker container: /app/data)
#BASEDIR=/app/data

# Subdirectory within BASEDIR for the downloaded activity files.
DOWNLOAD_DIR=garmin_activities

# Name of the SQLite database file (stored in BASEDIR/DOWNLOAD_DIR).
DB_FILE=garmin_activities.db


# ------------------------------------------------------------
# Download Settings
# ------------------------------------------------------------

# Number of most recent activities to download.
# Always refers to the N latest activities in Garmin Connect.
LIMIT_ACTIVITIES=5

# File format for downloads.
# Allowed values: fit | tcx | both
# fit  = binary Garmin format (compact, contains all sensor data)
# tcx  = XML-based format (compatible with many third-party tools)
# both = download both formats simultaneously
DOWNLOAD_FORMAT=both


# ------------------------------------------------------------
# Filename Template
# Available placeholders:
#   {activityId}            — Unique Garmin activity ID    (e.g. 1234567890)
#   {activityName}          — Name of the activity         (e.g. Morning Run)
#   {activityType}          — Activity type                (e.g. running, cycling)
#   {activityStartDate}     — Start date                   (e.g. 2026-06-10)
#   {activityStartDateTime} — Start date and time          (e.g. 2026-06-10_08-30-00)
# ------------------------------------------------------------
FILENAME_TEMPLATE="{activityStartDateTime}_{activityName}"


# ------------------------------------------------------------
# Folder Structure
# ------------------------------------------------------------

# Create a subfolder for each file format (fit, tcx) within the download directory.
# Recommended when DOWNLOAD_FORMAT=both.
SUBFOLDER_PER_FORMAT=true

# Create a subfolder for each activity type (running, cycling, ...) within the download directory.
SUBFOLDER_PER_ACTIVITYTYPE=true

# Group activity sub-types under their parent type when creating subfolders or using {activityType} in the filename template.
# If enabled, activities like "trail_running" or "treadmill_running" are treated as "running".
# Only relevant when SUBFOLDER_PER_ACTIVITYTYPE=true or {activityType} is used in FILENAME_TEMPLATE.
USE_PARENT_ACTIVITY_TYPE=false


# ------------------------------------------------------------
# Migration of Existing Files
# Only relevant if the folder structure or filename template is changed
# after the initial download. Reset to false after a successful migration.
# ------------------------------------------------------------

# Renames existing files to match the current FILENAME_TEMPLATE.
RENAME_EXISTING_FILES=false

# Moves existing files into the current folder structure
# (based on SUBFOLDER_PER_FORMAT and SUBFOLDER_PER_ACTIVITYTYPE).
REORDER_EXISTING_FILESTRUCTURE=false


# ------------------------------------------------------------
# Docker Mode / Scheduled Recurring Downloads
# ------------------------------------------------------------

# Enables continuous mode: the program downloads on startup, then repeats
# on the configured schedule.
# Default: true — keep enabled when running in a Docker container.
# Set to false to run the script only once.
DOCKERMODE=true

# Interval between download runs in seconds (only used when DOCKERMODE=true).
# Default: 86400 (= 24 hours)
# Note: Garmin Connect has rate limits — avoid setting this too low.
DOWNLOADINTERVAL=86400

# Optional fixed start time for the schedule (HH:MM, 24-hour format).
# If set, the first repeat runs at the next occurrence of this time,
# then repeats every DOWNLOADINTERVAL seconds from that anchor.
# If not set, the interval starts immediately after each download.
#
# Examples:
#   Daily at 18:00              → SCHEDULE_TIME=18:00  + DOWNLOADINTERVAL=86400
#   Every 6 hours starting 10:00 → SCHEDULE_TIME=10:00  + DOWNLOADINTERVAL=21600
#   Weekly (Mon 10:00)          → SCHEDULE_TIME=10:00  + DOWNLOADINTERVAL=604800
#SCHEDULE_TIME=18:00
